# Source images
export GO_IMG					?= mcr.microsoft.com/oss/go/microsoft/golang:1.24-cbl-mariner2.0
export MARINER_CORE_IMG			?= mcr.microsoft.com/cbl-mariner/base/core:2.0
export MARINER_DISTROLESS_IMG	?= mcr.microsoft.com/cbl-mariner/distroless/minimal:2.0
export WIN_HPC_IMG				?= mcr.microsoft.com/oss/kubernetes/windows-host-process-containers-base-image:v1.0.0


# Pinned images as image:tag@sha so Dependabot can update them.
export GO_PIN					?= $(GO_IMG)@$(shell skopeo inspect docker://${GO_IMG} --format "{{.Digest}}")
export MARINER_CORE_PIN			?= $(MARINER_CORE_IMG)@$(shell skopeo inspect docker://${MARINER_CORE_IMG} --format "{{.Digest}}")
export MARINER_DISTROLESS_PIN 	?= $(MARINER_DISTROLESS_IMG)@$(shell skopeo inspect docker://${MARINER_DISTROLESS_IMG} --format "{{.Digest}}")
export WIN_HPC_PIN				?= $(WIN_HPC_IMG)@$(shell skopeo inspect --override-os windows docker://${WIN_HPC_IMG} --format "{{.Digest}}")

export RENDER_MSG	?= "!! AUTOGENERATED - DO NOT EDIT !!"
export SRC 			?= ${PATH}/Dockerfile.tmpl
export DEST			?= ${PATH}/Dockerfile

print:
	@echo ${GO_PIN}
	@echo ${MARINER_CORE_PIN}
	@echo ${MARINER_DISTROLESS_PIN}
	@echo ${WIN_HPC_PIN}

render:
	build/tools/bin/renderkit -f ${SRC} --ds env:// > ${DEST}
