  "podLabelKey": "acn-npm-lite-role",
  "peerCIDRs": {
    "allowed-peer": "192.0.2.10/32",
    "denied-peer": "192.0.2.11/32"
  },
  "rejectionMessages": {
    "unsupported-peer-selector": "Non-CIDR blocks, named ports, and ingress/egress namespace/pod selectors are not supported when NPM Lite is enabled, allowing only CIDR-based policies",
