      "name": "ingress-cidr",
      "policy": {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "NetworkPolicy",
        "metadata": {"name": "ingress-cidr"},
        "spec": {
          "podSelector": {"matchLabels": {"acn-npm-lite-role": "subject"}},
          "policyTypes": ["Ingress"],
          "ingress": [{
            "from": [{"ipBlock": {"cidr": "192.0.2.10/32"}}],
            "ports": [{"protocol": "TCP", "port": 8080}]
          }]
        }
      },
      "rejection": "none",
      "probes": [
        {"from": "allowed-peer", "to": "subject", "protocol": "TCP", "port": 8080, "expect": "allow"},
        {"from": "denied-peer", "to": "subject", "protocol": "TCP", "port": 8080, "expect": "deny"}
      ]
    },
